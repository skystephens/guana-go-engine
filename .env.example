# ============================================
# GuanaGo San Andrés - Variables de Entorno
# ============================================

# AIRTABLE CONFIGURATION
# Obtén estos valores en: https://airtable.com/account
AIRTABLE_API_KEY=patXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXXXX

# La tabla debe llamarse "Directorio_Mapa" y tener campos:
# - Nombre (text): Nombre del lugar
# - Categoria (select): Restaurante, Hotel, etc.
# - Plan (select): Gratis, Estándar, Premium
# - Direccion (text): Dirección física
# - Telefono (text): Número de teléfono
# - Latitud (number): Coordenada Y (p.ej 12.5847)
# - Longitud (number): Coordenada X (p.ej -81.3871)
# - Foto_Principal (attachment): Imagen del lugar
# - ID_Slug (text): URL-friendly slug
# - Promo_Activa (text): Promoción vigente

# MAPBOX CONFIGURATION
# Obtén tu token público en: https://account.mapbox.com/tokens/
# Debe comenzar con "pk.eyJ..."
MAPBOX_API_KEY=pk.eyJ1IjoiZ3VhbmlhZ28iLCJhIjoiY2t2bW1iNnE2MGN1cDJvcG81bTVtbWQ0byJ9.XxX3p4f1b8K3J6F5Ykz9RQ

# VITE (Frontend) - Mapbox token para Vite
# Copia el mismo valor de MAPBOX_API_KEY
VITE_MAPBOX_API_KEY=pk.eyJ1IjoiZ3VhbmlhZ28iLCJhIjoiY2t2bW1iNnE2MGN1cDJvcG81bTVtbWQ0byJ9.XxX3p4f1b8K3J6F5Ykz9RQ

# MAKE.COM WEBHOOKS (Proxy para servicios externos)
# Si usas Make.com para integrar con otros servicios
MAKE_WEBHOOK_URL=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# PORT CONFIGURATION
# Puerto donde corre el backend (default: 3000)
# PORT=3000

# NODE ENVIRONMENT
NODE_ENV=development
# Cambiar a "production" antes de desplegar

# ============================================
# NOTAS:
# ============================================
# 1. NO commits este archivo si tiene valores reales
# 2. Copia este archivo a .env y reemplaza XXX
# 3. Para desarrollo, usa valores de test/sandbox
# 4. En producción, usa variables de entorno del servidor (Render, Vercel, etc)
# ============================================
